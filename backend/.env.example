PORT=8080
MONGODB_URI=mongodb://localhost:27017/mak_food
# >= 32 ký tự ngẫu nhiên, server từ chối khởi động nếu yếu. Tạo: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Dùng cho: npm run seed:admin (bắt buộc, mật khẩu >= 12 ký tự, không dùng mật khẩu phổ biến)
# Đổi mật khẩu admin đã có: npm run seed:admin -- --reset-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Dùng cho: npm run seed:demo (mặc định Demo@123)
DEMO_PASSWORD=Demo@123

# Đơn chờ quán nhận quá số phút này sẽ tự hủy (BR-36), mặc định 5
ORDER_TIMEOUT_MINUTES=5

# Số lớp proxy đứng trước backend, để rate limit đếm đúng IP người dùng:
#   chạy trực tiếp trên máy: để trống · chỉ nginx: 1 · Cloudflare Tunnel -> nginx (VPS lab): 2
TRUST_PROXY=

# Gửi mã OTP đăng ký qua Gmail. SMTP_PASS = "Mật khẩu ứng dụng" 16 ký tự
# (Google Account -> Bảo mật -> Xác minh 2 bước -> Mật khẩu ứng dụng), KHÔNG phải mật khẩu Gmail.
# Để trống SMTP_USER khi chạy trên máy: mã OTP được in ra console thay vì gửi email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MAK Food <your-account@gmail.com>

# Ví đối soát (API-11). Ví quán được âm tối đa WALLET_CREDIT_LIMIT đồng; vượt mức hoặc âm liên tục
# quá WALLET_GRACE_DAYS ngày -> quán tạm ngưng nhận đơn, tự mở lại khi số dư >= 0
WALLET_CREDIT_LIMIT=100000
WALLET_GRACE_DAYS=3
PAYOUT_MIN_AMOUNT=50000
TOPUP_MIN_AMOUNT=10000

# Tài khoản ngân hàng của MAK nhận tiền nạp (hiện mã VietQR cho chủ quán quét).
# PAYMENT_BANK_ID = mã ngân hàng VietQR (vd MB, VCB, TCB hoặc BIN 970422). Để trống -> không hiện QR
PAYMENT_BANK_ID= 
PAYMENT_ACCOUNT_NO= 
PAYMENT_ACCOUNT_NAME= 

# Thanh toán trả trước VietQR (W2). Chỉ bật khi có PAYMENT_BANK_ID + PAYMENT_ACCOUNT_NO ở trên VÀ khóa webhook.
# SEPAY_WEBHOOK_API_KEY: chuỗi ngẫu nhiên tự tạo (openssl rand -hex 32), dán cùng giá trị vào
# my.sepay.vn -> Webhooks -> Kiểu chứng thực "API Key". Webhook URL: https://<domain>/api/payments/sepay/webhook
SEPAY_WEBHOOK_API_KEY=
# Khách phải chuyển khoản trong số phút này, quá hạn đơn tự hủy
PAYMENT_TIMEOUT_MINUTES=15

# Bản đồ & quãng đường (đặc tả: Desktop "MAK Food — Đặc tả Bản đồ & Khoảng cách").
# GOONG_API_KEY: khóa REST của Goong (account.goong.io -> Keys -> API Key). Để trống -> quãng đường ước lượng
# (đường chim bay × 1,3) và tắt ô tìm địa chỉ bằng chữ.
GOONG_API_KEY=
# goong | estimate (mặc định: goong nếu có khóa)
ROUTING_PROVIDER=
# Loại phương tiện cho Goong Direction (xe máy) — kiểm tra lại tên tham số trong tài liệu Goong
GOONG_VEHICLE=bike
ROUTING_TIMEOUT_MS=3000

# Tài xế MAK (kế hoạch: Desktop "MAK Food — Kế hoạch triển khai Tài xế (Shipper)").
# Tiền công = SHIPPER_BASE_FEE cho SHIPPER_BASE_KM km đầu + SHIPPER_PER_KM mỗi km tiếp theo (MAK trả, khách miễn phí ship)
SHIPPER_BASE_FEE=10000
SHIPPER_BASE_KM=2
SHIPPER_PER_KM=3000
# Quán hủy khi tài xế đã nhận đơn (chưa lấy hàng) -> MAK bù cho tài xế
SHIPPER_CANCEL_COMPENSATION=5000
# Tài xế trả số đơn đã nhận LIÊN TIẾP này (chưa giao thành công đơn nào xen giữa) -> khóa nhận đơn 1 ngày
SHIPPER_MAX_CONSECUTIVE_WITHDRAWALS=3
# Điều phối: tìm trong bán kính (km) quanh quán, mỗi lời mời chờ (giây), tối đa số lời mời / số phút cho một lượt tìm
DISPATCH_RADIUS_KM=5
DISPATCH_OFFER_SECONDS=30
DISPATCH_MAX_OFFERS=5
DISPATCH_SEARCH_MINUTES=3
# Chỉ mời tài xế gửi vị trí trong số giây này; tài xế đang giao mất vị trí quá SHIPPER_STALE_MINUTES phút -> báo admin
SHIPPER_LOCATION_FRESH_SECONDS=120
SHIPPER_STALE_MINUTES=5

# Đăng ký ca tài xế (Desktop "MAK Food — Đặc tả Đăng ký ca tài xế (bản chốt)"). Giờ VN, cho lịch NGÀY MAI:
# hỏi quán "Theo lịch" lúc SHIFT_ASK_AT, chốt + gửi danh sách ca cho tài xế lúc SHIFT_CLOSE_AT, báo cáo quán lúc SHIFT_REPORT_AT
SHIFT_ASK_AT=14:00
SHIFT_CLOSE_AT=18:00
SHIFT_REPORT_AT=21:00
# Đăng ký / hủy ca miễn phạt tới N giờ trước giờ bắt đầu ca; hủy sau mốc này = vi phạm
SHIFT_CUTOFF_HOURS=2
# Số tài xế cần = số đơn dự kiến ÷ N (tròn lên, tối thiểu 1)
SHIFT_ORDERS_PER_DRIVER=6
# Thang phạt: không vi phạm số ngày này (tính từ lúc hết khóa) thì giảm bậc
PENALTY_DECAY_DAYS=30
