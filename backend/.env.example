PORT=8080
MONGODB_URI=mongodb://localhost:27017/mak_food
# >= 32 ký tự ngẫu nhiên, server từ chối khởi động nếu yếu. Tạo: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Dùng cho: npm run seed:admin (bắt buộc, mật khẩu >= 12 ký tự, không dùng mật khẩu phổ biến)
# Đổi mật khẩu admin đã có: npm run seed:admin -- --reset-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Dùng cho: npm run seed:demo (mặc định Demo@123)
DEMO_PASSWORD=Demo@123

# Đơn chờ quán nhận quá số phút này sẽ tự hủy (BR-36), mặc định 5
ORDER_TIMEOUT_MINUTES=5

# Số lớp proxy đứng trước backend, để rate limit đếm đúng IP người dùng:
#   chạy trực tiếp trên máy: để trống · chỉ nginx: 1 · Cloudflare Tunnel -> nginx (VPS lab): 2
TRUST_PROXY=

# Gửi mã OTP đăng ký qua Gmail. SMTP_PASS = "Mật khẩu ứng dụng" 16 ký tự
# (Google Account -> Bảo mật -> Xác minh 2 bước -> Mật khẩu ứng dụng), KHÔNG phải mật khẩu Gmail.
# Để trống SMTP_USER khi chạy trên máy: mã OTP được in ra console thay vì gửi email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MAK Food <your-account@gmail.com>

# Ví đối soát (API-11). Ví quán được âm tối đa WALLET_CREDIT_LIMIT đồng; vượt mức hoặc âm liên tục
# quá WALLET_GRACE_DAYS ngày -> quán tạm ngưng nhận đơn, tự mở lại khi số dư >= 0
WALLET_CREDIT_LIMIT=100000
WALLET_GRACE_DAYS=3
PAYOUT_MIN_AMOUNT=50000
TOPUP_MIN_AMOUNT=10000

# Tài khoản ngân hàng của MAK nhận tiền nạp (hiện mã VietQR cho chủ quán quét).
# PAYMENT_BANK_ID = mã ngân hàng VietQR (vd MB, VCB, TCB hoặc BIN 970422). Để trống -> không hiện QR
PAYMENT_BANK_ID= 
PAYMENT_ACCOUNT_NO= 
PAYMENT_ACCOUNT_NAME= 

# Thanh toán trả trước VietQR (W2). Chỉ bật khi có PAYMENT_BANK_ID + PAYMENT_ACCOUNT_NO ở trên VÀ khóa webhook.
# SEPAY_WEBHOOK_API_KEY: chuỗi ngẫu nhiên tự tạo (openssl rand -hex 32), dán cùng giá trị vào
# my.sepay.vn -> Webhooks -> Kiểu chứng thực "API Key". Webhook URL: https://<domain>/api/payments/sepay/webhook
SEPAY_WEBHOOK_API_KEY=
# Khách phải chuyển khoản trong số phút này, quá hạn đơn tự hủy
PAYMENT_TIMEOUT_MINUTES=15
